.worktrees/
node_modules/
dist/
test-results/
playwright-report/
.superpowers/
work/*
!work/assets-source/
!work/assets-source/**

# Track only asset provenance metadata, never the multi-hundred-MB source
# archives or their extracted originals. Originals stay on disk under
# work/assets-source/ so licensing is auditable without bloating the repo.
work/assets-source/incoming/
work/assets-source/**/original/

# Recorded sound effects are per-developer downloads (see public/assets/audio/sfx/README.md).
public/assets/audio/sfx/*.mp3
public/assets/audio/sfx/*.wav
